{
  "version": 4,
  "final_space": true,
  "palette": {
    "path": "#8FB6D8",
    "drive": "#A5B4C4",
    "folder": "#56B6C2",
    "clean": "#98C379",
    "changed": "#E5C07B",
    "error": "#E06C75",
    "muted": "#9DA5B4",
    "rail": "#596574",
    "surface": "#252B33"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:muted",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:error{{ end }}"
    ],
    "template": "❯ ",
    "newline": false
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:rail",
          "template": "╭─"
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:muted",
          "foreground_templates": [
            "{{ if .Root }}p:error{{ end }}"
          ],
          "template": "{{ if .Root }} admin {{ else if .SSHSession }} {{ .UserName }}@{{ .HostName }} {{ end }}"
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "p:surface",
          "foreground": "p:path",
          "options": {
            "style": "agnoster_short",
            "max_depth": 2,
            "folder_icon": "…",
            "folder_separator_icon": "/",
            "left_format": "<p:drive>%s</>",
            "right_format": "<p:folder>%s</>"
          },
          "template": "<p:drive>\uf0a0</> {{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "min_width": 70,
          "foreground": "p:clean",
          "foreground_templates": [
            "{{ if or (gt .Working.Unmerged 0) (gt .Staging.Unmerged 0) }}p:error{{ else if or .Working.Changed .Staging.Changed }}p:changed{{ end }}"
          ],
          "options": {
            "fetch_status": true,
            "fetch_stash_count": true,
            "branch_max_length": 24,
            "truncate_symbol": "…",
            "branch_icon": "\ue0a0 "
          },
          "template": " <p:rail>─</> {{ .HEAD }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if .Staging.Changed }} S:{{ .Staging.String }}{{ end }}{{ if .Working.Changed }} W:{{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} ≡{{ .StashCount }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hide",
      "filler": "<p:rail>─</>",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "min_width": 80,
          "foreground": "p:error",
          "options": {
            "always_enabled": false
          },
          "template": " exit {{ .Code }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "min_width": 80,
          "foreground": "p:changed",
          "options": {
            "style": "austin",
            "threshold": 1000,
            "always_enabled": false
          },
          "template": " {{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "plain",
          "min_width": 50,
          "foreground": "p:muted",
          "options": {
            "time_format": "15:04"
          },
          "template": " \uf017 {{ .CurrentDate | date .Format }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:rail",
          "template": "╮"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:rail",
          "template": "╰─ "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:clean",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:error{{ end }}"
          ],
          "template": "❯"
        }
      ]
    },
    {
      "type": "rprompt",
      "overflow": "hide",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:rail",
          "template": "─╯"
        }
      ]
    }
  ]
}
