{
  "$schema": "https://planxlab.com",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "filler": "<transparent><#3a3a3a>·</></>",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "<#6c6c6c,transparent>╭─</><#87afaf,transparent>\ue0b6</>",
          "trailing_diamond": "\ue0bc",
          "background": "#87afaf",
          "foreground": "#080808",
          "template": " {{ .Icon }} "
        },
        {
          "type": "session",
          "style": "diamond",
          "trailing_diamond": "\ue0bc",
          "background": "#444444",
          "foreground": "#bcbcbc",
          "background_templates": [
            "{{ if .Root }}#af5f5f{{ end }}"
          ],
          "foreground_templates": [
            "{{ if .Root }}#dadada{{ end }}"
          ],
          "template": " \uf007 {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "diamond",
          "trailing_diamond": "\ue0bc",
          "background": "#5f87af",
          "foreground": "#dadada",
          "options": {
            "style": "fish",
            "dir_length": 1
          },
          "template": " \uf07c {{ .Path }} "
        },
        {
          "type": "git",
          "style": "diamond",
          "trailing_diamond": "\ue0bc",
          "background": "#87af87",
          "foreground": "#080808",
          "background_templates": [
            "{{ if or (gt .Working.Unmerged 0) (gt .Staging.Unmerged 0) }}#af5f5f{{ end }}",
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#d7af5f{{ end }}"
          ],
          "options": {
            "fetch_status": true,
            "fetch_stash_count": true,
            "branch_max_length": 32,
            "truncate_symbol": "…",
            "branch_icon": "\uf418 "
          },
          "template": " {{ .HEAD }}{{ if gt .Behind 0 }} \uf063 {{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} \uf062 {{ .Ahead }}{{ end }}{{ if gt .StashCount 0 }} \uf01c {{ .StashCount }}{{ end }}{{ if gt .Staging.Unmerged 0 }} <#dadada>\uf071 {{ .Staging.Unmerged }}</>{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.Total }}{{ end }}{{ if gt .Working.Modified 0 }} \uf044 {{ .Working.Modified }}{{ end }}{{ if gt .Working.Untracked 0 }} \uf059 {{ .Working.Untracked }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "diamond",
          "leading_diamond": "\ue0ba",
          "background": "#af5f5f",
          "foreground": "#dadada",
          "options": {
            "always_enabled": false
          },
          "template": " \uf00d {{ .Code }} "
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "\ue0ba",
          "background": "#afaf5f",
          "foreground": "#080808",
          "options": {
            "style": "austin",
            "always_enabled": true
          },
          "template": " \uf252 {{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": "\ue0ba",
          "trailing_diamond": "<#87afaf,transparent>\ue0b4</><#6c6c6c,transparent>─╮</>",
          "background": "#87afaf",
          "foreground": "#080808",
          "options": {
            "time_format": "15:04:05"
          },
          "template": " \uf017 {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#6c6c6c",
          "template": "╰─"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#87afaf",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#af5f5f{{ end }}"
          ],
          "template": "⚡"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#6c6c6c",
          "template": "─╯"
        }
      ]
    }
  ]
}
