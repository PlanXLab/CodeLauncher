{
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.venv": true,
    "**/.temp": true,
    "**/.git": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.vscode/**": true,
    "**/.cache/**": true
  },
  "search.exclude": {
    "**/dist/**": true,
    "**/build/**": true
  },
  "editor.mouseWheelZoom": true,
  "editor.fontFamily": "'0xProto Nerd Font', DalseoHealing, monospace",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,

  "workbench.colorTheme": "One Dark Pro Darker",
  "workbench.iconTheme": "ayu",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 22,

  "window.commandCenter": false,

  "terminal.integrated.mouseWheelZoom": true,
  "terminal.integrated.fontSize": 14,
  "terminal.explorerKind": "integrated",
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.env.windows": {
    "PATH": "${env:VSCODE_PORTABLE}\\..\\bin;${env:VSCODE_PORTABLE}\\lib\\python;${env:VSCODE_PORTABLE}\\lib\\python\\Scripts;${env:VSCODE_PORTABLE}\\lib\\pwsh;${env:VSCODE_PORTABLE}\\lib\\pwsh\\bin;${env:PATH}"
  },
  
  "terminal.integrated.allowChords": false,
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.commandsToSkipShell": [
    "-workbench.action.openRecent",               // Ctrl+R (PSFzf history search)
    "-workbench.action.quickOpen",                // Ctrl+E (line end)
    "-workbench.action.terminal.selectAll",       // Ctrl+A (line start)
    "-workbench.action.terminal.clear",           // Ctrl+K (delete after cursor)
    "-workbench.action.showAllSymbols"            // Ctrl+T (PSFzf file search)
  ],

  "terminal.integrated.defaultProfile.windows": "PowerShell 7 (portable)",

  "terminal.integrated.profiles.windows": {
    "PowerShell 7 (portable)": {
      "path": "${env:VSCODE_PORTABLE}\\lib\\pwsh\\pwsh.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NoExit",
        "-Command",
        ". \"$env:VSCODE_PORTABLE\\lib\\pwsh\\Microsoft.PowerShell_profile.ps1\""
      ],
      "icon": "terminal-powershell"
    }
  },

  "python.defaultInterpreterPath": "${env:VSCODE_PORTABLE}\\lib\\python\\python.exe",
  "python.terminal.activateEnvironment": false,
  "python.venvFolders": [],
  "python.useEnvironmentsExtension": false,
  "python.createEnvironment.trigger": "off",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingModuleSource": "none"
  },
  "python.analysis.exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/.vscode",
    "**/build",
    "**/dist",
    "**/.git"
  ],

  "explorer.confirmDelete": false,
  "explorer.confirmPasteNative": false
}
